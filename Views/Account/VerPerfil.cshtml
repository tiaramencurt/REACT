@{
    ViewData["Title"] = "Ver Perfil";
}

<section>
    <h1 class="title">Perfil</h1>
</section>

<section class="informacion">
    <h3>Username: @ViewBag.Usuario.Username</h3>
    <h3>Mail: @ViewBag.Usuario.Mail</h3>
    @if(@ViewBag.Usuario.Tipo == true)
    {
        <h3>Tipo: Servicio de emergencia</h3>
        <img src="/imagenes/ambulancia.png" alt="Ambulancia" class="avatar">
    }else
    {
        <h3>Tipo: Particular</h3>
        <img src="/imagenes/auto.png" alt="Ambulancia" class="avatar">
    }
</section> 
<div>
    <a href='@Url.Action("CerrarSesion", "Account")' class="secondary-button">Cerrar Sesión</a>
</div>
