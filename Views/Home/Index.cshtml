@{
    ViewData["Title"] = "Inicio";
}

<main class="Landing">
    <section class="titulo">
        <img src="imagenes/logo completo (2).jpg" alt="logo react">
        <h2>Rapid Emergency Alert & Clear Traffic</h2>
    </section>

    <section class="contenedor-texto">
        <h3>¿Quiénes somos?</h3>
        <p>
            Somos un equipo dedicado a transformar la respuesta de los servicios de emergencia en entornos urbanos complejos.
            A través de una plataforma innovadora, optimizamos los tiempos de desplazamiento y mejoramos la toma de decisiones de los operadores,
            superando los retos del tráfico denso que ponen en riesgo la vida de las personas.
        </p>
    </section>

    <section class="contenedor-texto">
        <h3>¿Cuál es nuestro objetivo?</h3>
        <p>
            Nuestro objetivo es enfrentar el tráfico urbano que retrasa a los servicios de emergencia y pone en riesgo vidas,
            reduciendo al máximo los tiempos de respuesta.
        </p>
    </section>

    <section class="contenedor-texto">
        <h3>¿Cómo funciona REACT?</h3>
        <p>
            Nuestra aplicación conecta en tiempo real a los servicios de emergencia con el sistema de tránsito.
            Cuando se detecta una alerta, REACT analiza el tráfico y envía avisos a los vehículos cercanos para liberar el paso.
        </p>
    </section>

    <section class="contenedor-texto">
        <h3>¿Por qué es importante?</h3>
        <p>
            Cada minuto cuenta durante una emergencia.
            REACT busca reducir los tiempos de respuesta, mejorar la coordinación y aumentar la seguridad tanto para los equipos de emergencia como para la comunidad.
        </p>
    </section>

    <div>
        <a href='@Url.Action("Login", "Account")'>Iniciar sesión</a>
        <a href='@Url.Action("Registrarse", "Account")'>Registrarse</a>
    </div>

    <h1 class="titulo-landing">Nuestros usuarios:</h1>
    <section class="cards">
        <div class="card">
            <img src="/imagenes/Martin.png" alt="Martin" class="avatar">
            <h3>Martin Levy</h3>
            <p>42 años</p>
            <p><strong>Empresa de seguros</strong></p>
            <p><strong>Objetivos:</strong> llegar puntual, manejar tranquilo y no recibir multas</p>
            <p><strong>Frustraciones:</strong> el tránsito lento y no saber cómo reaccionar ante ambulancias</p>
        </div>

        <div class="card">
            <img src="/imagenes/Kiara.png" alt="Kiara" class="avatar">
            <h3>Kiara Cohen</h3>
            <p>34 años</p>
            <p><strong>Médica</strong></p>
            <p><strong>Objetivos:</strong> llegar lo más rápido posible a la emergencia y salvar vidas</p>
            <p><strong>Frustraciones:</strong> los autos que no respetan el paso de ambulancias y los conductores distraídos</p>
        </div>
    </section>

    <h1 class="titulo-landing">Los creadores:</h1>
    <section class="creadores">
        <div class="creador">
            <img src="/imagenes/Martin.png" alt="Maica" class="avatar">
            <h3>Maica Trutner</h3>
            <p>Project Leader & Back</p>
        </div>

        <div class="creador">
            <img src="/imagenes/Martin.png" alt="Gael" class="avatar">
            <h3>Gael Mizrahi</h3>
            <p>Fullstack</p>
        </div>

        <div class="creador">
            <img src="/imagenes/Martin.png" alt="Martin" class="avatar">
            <h3>Milena Svatzky</h3>
            <p>Diseño</p>
        </div>

        <div class="creador">
            <img src="/imagenes/shoffer.JPG" alt="Shoffer" class="avatar">
            <h3>Ivan Shoffer</h3>
            <p>Backend</p>
        </div>
    </section>

     <section id="carouselReact" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="imagenes/slide1.png" class="d-block-w-100" alt="imagen 1">
            </div>

            <div class="carousel-item">
                <img src="imagenes/slide2.png" class="d-block-w-100" alt="imagen 2">
            </div>

            <div class="carousel-item">
                <img src="imagenes/slide3.png" class="d-block-w-100" alt="imagen 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselReact" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carouselReact" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </section>


</main>
