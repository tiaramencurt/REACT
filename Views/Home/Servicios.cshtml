@{
    ViewData["Title"] = "Servicios";
    bool? estadoUltimoViaje = ViewBag.estadoUltimoViaje as bool?;
    int? idViaje = ViewBag.idViaje as int?;
    bool viajeActivo = (idViaje != null && estadoUltimoViaje == true);
}

<main class="Landing">
    <section class="principal">
        <h1 class="title">Servicio de Emergencia</h1>
        @if (!viajeActivo)
        {
            <a href='@Url.Action("CrearViaje", "Home")' class="primary-button">Crear viaje</a>
            <img src="/imagenes/flecha.png" alt="Flecha" class="flecha">
            <h2 class="titulo-landing">Tocá allí para Crear un Viaje y mandar tu ubicación a los conductores cercanos.</h2>
        }
        else
        {
            <a href='@Url.Action("FinalizarViaje", "Home", new { IdViaje = idViaje })' class="secondary-button">Finalizar
                viaje</a>
            <section class="viaje-estado">
                <div class="spinner-grow spinner-rojo" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Tu viaje se está compartiendo correctamente...</p>
            </section>
            <div class="doble-bloque">
                <div class="bloque">
                    <h2 class="ubicacion">Tu ubicación actual:</h2>
                    <div class="iframe">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3283.769640147675!2d-58.431717223530626!3d-34.60998615783049!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcca680b697a73%3A0xb6fa8d39f7cf0dc9!2sEscuela%20ORT%20sede%20Almagro!5e0!3m2!1ses-419!2sar!4v1764347256242!5m2!1ses-419!2sar"
                            allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
                <div class="bloque">
                    <h1 class="ubicacion">Hospitales cercanos:</h1>
                    <section id="carouselReact" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="/imagenes/hospital_italiano.png" class="d-block-w-100" alt="imagen 1">
                                <p>A 0,7km de tu ubicación</p>
                            </div>

                            <div class="carousel-item">
                                <img src="/imagenes/hospital_durand.png" class="d-block-w-100" alt="imagen 2">
                                <p>A 1km de tu ubicación</p>
                            </div>

                            <div class="carousel-item">
                                <img src="/imagenes/hospital_3.png" class="d-block-w-100" alt="imagen 3">
                                <p>A 1,1km de tu ubicación</p>
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselReact"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#carouselReact"
                            data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </section>
                </div>
            </div>
        }
    </section>
</main>

<script>
    var idViaje = @(idViaje ?? 0);
    var viajeActivo = @viajeActivo.ToString().ToLower();

    function enviarUbicacionAuto() {
        if (!viajeActivo || idViaje === 0) return;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                const lat = position.coords.latitude.toString().replace('.', ',');
                const lon = position.coords.longitude.toString().replace('.', ',');
                fetch('/Home/GuardarUbicacion?Latitud=' + lat + '&Longitud=' + lon + '&IdViaje=' + idViaje, {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                });
            });
        }
    }
    setInterval(enviarUbicacionAuto, 5000);
</script>